# Server Configuration
PORT=5000

# Hatch Alarm Clock Integration
# Get these from your Hatch account at https://hatchsleep.com
# 1. Log in to your Hatch account
# 2. Go to Settings > Integrations > API
# 3. Generate an API token and copy your device ID

HATCH_ACCESS_TOKEN=your_hatch_api_token_here
HATCH_DEVICE_ID=your_hatch_device_id_here

# Optional: Custom API URL (defaults to api.hatch.co)
# HATCH_API_URL=api.hatch.co
